                                    <input type="password" id="loginPassword" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-secondary focus:border-transparent" placeholder="••••••••">
                                </div>
                                <div id="loginError" class="text-red-500 text-sm hidden"></div>
                                <button type="submit" class="w-full bg-brand-primary text-white py-3 rounded-lg font-semibold hover:bg-opacity-90 transition">
                                    Entrar
                                </button>
                            </form>
                            <div class="mt-6 text-center text-xs text-gray-500">
                                <p><strong>Admin:</strong> cami@microsistec.com / admin123</p>
                            </div>
                        </div>
                    </div>
                `;
  },

            home() {
                const contents = DB.getContents();
                const categories = [...new Set(contents.map(c => c.category))
    ];
                const user = DB.getCurrentUser();

                return `
                    <div class="min-h-screen bg-brand-bg">
                        ${this.header()
    }
                        
                        <div class="max-w-6xl mx-auto px-6 py-12">
                            <div class="mb-8">
                                <h2 class="text-3xl font-bold text-brand-primary mb-2">Olá, ${user.name
    }! 👋</h2>
                                <p class="text-gray-600 text-lg">Acesse todo o conhecimento comercial da Microsistec em um só lugar.</p>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                ${categories.map(cat => {
                                    const catContents = contents.filter(c => c.category === cat);
                                    const icons = {
                                        'Missão e Posicionamento': '🎯',
                                        'Produtos e Matriz': '📦',
                                        'ICP e Perfil de Cliente': '👥',
                                        'Processos Comerciais': '⚙️'
        };
                                    return `
                                        <div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-all border border-gray-100 hover:border-brand-secondary cursor-pointer" onclick="showCategory('${cat}')">
                                            <div class="text-4xl mb-4">${icons[cat
          ] || '📄'
        }</div>
                                            <h3 class="font-bold text-lg text-brand-primary mb-2">${cat
        }</h3>
                                            <p class="text-sm text-gray-500">${catContents.length
        } documento${catContents.length > 1 ? 's' : ''
        }</p>
                                        </div>
                                    `;
      }).join('')
    }
                            </div>

                            <div class="mt-12">
                                <h3 class="text-xl font-bold text-brand-primary mb-4">Todos os Documentos</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    ${contents.map(c => `
                                        <div onclick="Router.navigate('content', {id: ${c.id}})" class="bg-white p-5 rounded-lg shadow-sm hover:shadow-md transition cursor-pointer border border-gray-100 hover:border-brand-secondary">
                                            <h4 class="font-semibold text-brand-primary mb-1">${c.title
      }</h4>
                                            <p class="text-xs text-gray-500">${c.category
      }</p>
                                        </div>
                                    `).join('')
    }
                                </div>
                            </div>
                        </div>
                    </div>
                `;
  },

            content(id) {
                const contents = DB.getContents();
                const content = contents.find(c => c.id === id);
                if (!content) return '<div class="p-8">Conteúdo não encontrado</div>';

                return `
                    <div class="min-h-screen bg-brand-bg">
                        ${this.header()
    }
                        
                        <div class="max-w-4xl mx-auto px-6 py-12">
                            <button onclick="Router.navigate('home')" class="mb-6 text-brand-secondary hover:underline flex items-center gap-2">
                                ← Voltar para biblioteca
                            </button>
                            
                            <div class="bg-white rounded-xl shadow-sm p-8">
                                <div class="mb-6">
                                    <span class="text-xs font-semibold text-brand-secondary bg-blue-50 px-3 py-1 rounded-full">${content.category
    }</span>
                                </div>
                                <h1 class="text-3xl font-bold text-brand-primary mb-6">${content.title
    }</h1>
                                <div class="prose max-w-none text-gray-700 leading-relaxed whitespace-pre-line">
                                    ${content.content
    }
                                </div>
                            </div>
                        </div>
                    </div>
                `;
  },

            admin() {
                if (!Auth.isAdmin()) {
                    return '<div class="p-8 text-center text-red-500">Acesso negado</div>';
    }

                return `
                    <div class="min-h-screen bg-gray-50">
                        ${this.header()
    }
                        
                        <div class="max-w-6xl mx-auto px-6 py-8">
                            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                                <aside class="lg:col-span-1">
                                    <div class="bg-white rounded-xl shadow-sm p-6">
                                        <h3 class="font-bold text-brand-primary mb-4">Painel Admin</h3>
                                        <nav class="space-y-2">
                                            <button onclick="showAdminTab('content')" class="w-full text-left p-3 rounded-lg hover:bg-gray-50 flex items-center gap-2 text-sm">
                                                📄 Gerenciar Conteúdos
                                            </button>
                                            <button onclick="showAdminTab('users')" class="w-full text-left p-3 rounded-lg hover:bg-gray-50 flex items-center gap-2 text-sm">
                                                👥 Gerenciar Usuários
                                            </button>
                                        </nav>
                                    </div>
                                </aside>

                                <main class="lg:col-span-3">
                                    <div id="adminContent">
                                        ${this.adminContentManager()
    }
                                    </div>
                                </main>
                            </div>
                        </div>
                    </div>
                `;
  },

            adminContentManager() {
                const contents = DB.getContents();
                return `
                    <div class="bg-white rounded-xl shadow-sm p-8">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-2xl font-bold text-brand-primary">Gerenciar Conteúdos</h3>
                            <button onclick="showAddContentModal()" class="bg-brand-primary text-white px-4 py-2 rounded-lg font-semibold hover:bg-opacity-90 transition flex items-center gap-2">
                                + Novo Conteúdo
                            </button>
                        </div>
                        
                        <div class="space-y-3">
                            ${contents.map(c => `
                                <div class="border border-gray-200 rounded-lg p-4 hover:border-brand-secondary transition">
                                    <div class="flex justify-between items-start">
                                        <div class="flex-1">
                                            <h4 class="font-semibold text-brand-primary">${c.title
      }</h4>
                                            <p class="text-xs text-gray-500 mt-1">${c.category
      }</p>
                                        </div>
                                        <div class="flex gap-2">
                                            <button onclick="editContent(${c.id})" class="text-blue-500 hover:text-blue-700 text-sm">Editar</button>
                                            <button onclick="deleteContent(${c.id})" class="text-red-500 hover:text-red-700 text-sm">Excluir</button>
                                        </div>
                                    </div>
                                </div>
                            `).join('')
    }
                        </div>
                    </div>
                `;
  },

            adminUserManager() {
                const users = DB.getUsers();
                return `
                    <div class="bg-white rounded-xl shadow-sm p-8">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-2xl font-bold text-brand-primary">Gerenciar Usuários</h3>
                            <button onclick="showAddUserModal()" class="bg-brand-accent text-white px-4 py-2 rounded-lg font-semibold hover:bg-opacity-90 transition flex items-center gap-2">
                                + Novo Usuário
                            </button>
                        </div>
                        
                        <div class="space-y-3">
                            ${users.map(u => `
                                <div class="border border-gray-200 rounded-lg p-4 hover:border-brand-secondary transition">
                                    <div class="flex justify-between items-center">
                                        <div>
                                            <p class="font-semibold text-brand-primary">${u.name || u.email
      }</p>
                                            <p class="text-sm text-gray-500">${u.email
      }</p>
                                        </div>
                                        <div class="flex items-center gap-3">
                                            <span class="text-xs font-bold px-3 py-1 rounded-full ${u.role === 'admin' ? 'bg-brand-accent text-white' : 'bg-gray-200 text-gray-700'}">
                                                ${u.role === 'admin' ? 'Admin' : 'Visualizador'
      }
                                            </span>
                                            ${u.email !== 'cami@microsistec.com' ? `
                                                <button onclick="deleteUser('${u.email}')" class="text-red-500 hover:text-red-700 text-sm">Excluir</button>
                                            ` : ''
      }
                                        </div>
                                    </div>
                                </div>
                            `).join('')
    }
                        </div>
                    </div>
                `;
  },

            search(query) {
                const contents = DB.getContents();
                const results = contents.filter(c => 
                    c.title.toLowerCase().includes(query.toLowerCase()) ||
                    c.content.toLowerCase().includes(query.toLowerCase()) ||
                    c.category.toLowerCase().includes(query.toLowerCase())
                );

                return `
                    <div class="min-h-screen bg-brand-bg">
                        ${this.header()
    }
                        
                        <div class="max-w-4xl mx-auto px-6 py-12">
                            <button onclick="Router.navigate('home')" class="mb-6 text-brand-secondary hover:underline flex items-center gap-2">
                                ← Voltar para biblioteca
                            </button>
                            
                            <h2 class="text-2xl font-bold text-brand-primary mb-2">Resultados da Busca</h2>
                            <p class="text-gray-600 mb-6">${results.length
    } resultado${results.length !== 1 ? 's' : ''
    } para "${query}"</p>
                            
                            <div class="space-y-4">
                                ${results.length > 0 ? results.map(c => `
                                    <div onclick="Router.navigate('content', {id: ${c.id}})" class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition cursor-pointer border border-gray-100 hover:border-brand-secondary">
                                        <h3 class="font-semibold text-brand-primary mb-2">${c.title
      }</h3>
                                        <p class="text-xs text-gray-500 mb-2">${c.category
      }</p>
                                        <p class="text-sm text-gray-600 line-clamp-2">${c.content.substring(0,
        150)
      }...</p>
                                    </div>
                                `).join('') : '<p class="text-gray-500">Nenhum resultado encontrado.</p>'
    }
                            </div>
                        </div>
                    </div>
                `;
  },

            header() {
                const user = DB.getCurrentUser();
                return `
                    <header class="bg-brand-primary text-white shadow-lg">
                        <div class="max-w-6xl mx-auto px-6 py-4">
                            <div class="flex justify-between items-center">
                                <div class="flex items-center gap-3 cursor-pointer" onclick="Router.navigate('home')">
                                    <svg class="w-8 h-8 text-brand-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                    </svg>
                                    <h1 class="text-xl font-bold">Biblioteca Comercial</h1>
                                </div>
                                
                                <div class="flex items-center gap-4">
                                    <div class="relative">
                                        <input 
                                            type="text" 
                                            id="searchInput"
                                            placeholder="Buscar..." 
                                            onkeypress="if(event.key === 'Enter') performSearch()"
                                            class="pl-10 pr-4 py-2 rounded-lg bg-white/10 text-white placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-brand-secondary w-64"
                                        >
                                        <svg class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                        </svg>
                                    </div>
                                    
                                    ${Auth.isAdmin() ? `
                                        <button onclick="Router.navigate('admin')" class="bg-brand-accent text-white px-4 py-2 rounded-lg font-semibold hover:bg-opacity-90 transition text-sm">
                                            Admin
                                        </button>
                                    ` : ''
    }
                                    
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm">${user.name
    }</span>
                                        <button onclick="Auth.logout()" class="text-sm text-gray-300 hover:text-white">
                                            Sair
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </header>
                `;
  }
};

        // ============================================
// FUNÇÕES GLOBAIS
// ============================================
        function handleLogin(event) {
            event.preventDefault();
            const email = document.getElementById('loginEmail').value;
            const password = document.getElementById('loginPassword').value;
            const result = Auth.login(email, password);
            
            if (result.success) {
                Router.navigate('home');
  } else {
                const errorDiv = document.getElementById('loginError');
                errorDiv.textContent = result.message;
                errorDiv.classList.remove('hidden');
  }
}

        function performSearch() {
            const query = document.getElementById('searchInput').value;
            if (query.trim()) {
                Router.navigate('search',
    { query
    });
  }
}

        function showCategory(category) {
            const contents = DB.getContents().filter(c => c.category === category);
            // Por enquanto, vamos apenas mostrar o primeiro conteúdo da categoria
            if (contents.length > 0) {
                Router.navigate('content',
    { id: contents[
        0
      ].id
    });
  }
}

        function showAdminTab(tab) {
            const adminContent = document.getElementById('adminContent');
            if (tab === 'content') {
                adminContent.innerHTML = Pages.adminContentManager();
  } else if (tab === 'users') {
                adminContent.innerHTML = Pages.adminUserManager();
  }
}

        function showAddContentModal() {
            const title = prompt('Título do conteúdo:');
            if (!title) return;
            
            const category = prompt('Categoria (Missão e Posicionamento, Produtos e Matriz, ICP e Perfil de Cliente, Processos Comerciais):');
            if (!category) return;
            
            const content = prompt('Conteúdo (cole o texto completo):');
            if (!content) return;

            const contents = DB.getContents();
            const newId = Math.max(...contents.map(c => c.id),
  0) + 1;
            contents.push({ id: newId, title, category, content
  });
            DB.saveContents(contents);
            
            showAdminTab('content');
            alert('Conteúdo adicionado com sucesso!');
}

        function editContent(id) {
            const contents = DB.getContents();
            const content = contents.find(c => c.id === id);
            
            const newTitle = prompt('Novo título:', content.title);
            if (!newTitle) return;
            
            const newCategory = prompt('Nova categoria:', content.category);
            if (!newCategory) return;
            
            const newContent = prompt('Novo conteúdo:', content.content);
            if (!newContent) return;

            content.title = newTitle;
            content.category = newCategory;
            content.content = newContent;
            DB.saveContents(contents);
            
            showAdminTab('content');
            alert('Conteúdo atualizado com sucesso!');
}

        function deleteContent(id) {
            if (!confirm('Tem certeza que deseja excluir este conteúdo?')) return;
            
            const contents = DB.getContents();
            const filtered = contents.filter(c => c.id !== id);
            DB.saveContents(filtered);
            
            showAdminTab('content');
            alert('Conteúdo excluído com sucesso!');
}

        function showAddUserModal() {
            const name = prompt('Nome do usuário:');
            if (!name) return;
            
            const email = prompt('E-mail do usuário:');
            if (!email) return;
            
            const password = prompt('Senha inicial:');
            if (!password) return;
            
            const role = prompt('Nível de acesso (admin ou viewer):', 'viewer');
            if (!role) return;

            const users = DB.getUsers();
            if (users.find(u => u.email === email)) {
                alert('Este e-mail já está cadastrado!');
                return;
  }

            users.push({ name, email, password, role
  });
            DB.saveUsers(users);
            
            showAdminTab('users');
            alert('Usuário criado com sucesso!');
}

        function deleteUser(email) {
            if (!confirm('Tem certeza que deseja excluir este usuário?')) return;
            
            const users = DB.getUsers();
            const filtered = users.filter(u => u.email !== email);
            DB.saveUsers(filtered);
            
            showAdminTab('users');
            alert('Usuário excluído com sucesso!');
}
// ============================================
// INICIALIZAÇÃO
// ============================================
        DB.init();
        Router.render();
    </script>
</body>
</html>