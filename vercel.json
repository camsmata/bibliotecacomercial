                    case 'home':
                        app.innerHTML = Pages.home();
                        break;
                    case 'content':
                        app.innerHTML = Pages.content(this.params.id);
                        break;
                    case 'admin':
                        app.innerHTML = Pages.admin();
                        break;
                    case 'search':
                        app.innerHTML = Pages.search(this.params.query);
                        break;
    }
  }
};

